#!/usr/bin/env sh
##############################################################################
# Gradle wrapper bootstrap script (Unix)
#
# This stub is committed in place of the real wrapper so the repo doesn't
# contain the binary gradle-wrapper.jar.  Generate the real wrapper once:
#
#   cd eve-android
#   gradle wrapper --gradle-version 8.2
#
# That command creates:
#   gradlew            (this file, replaced with the real one)
#   gradlew.bat        (Windows equivalent)
#   gradle/wrapper/gradle-wrapper.jar  (the binary bootstrap)
#
##############################################################################
set -e
GRADLE_WRAPPER_JAR="$(dirname "$0")/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$GRADLE_WRAPPER_JAR" ]; then
  echo "ERROR: gradle-wrapper.jar not found at $GRADLE_WRAPPER_JAR"
  echo "Run: gradle wrapper --gradle-version 8.2  in the eve-android/ directory."
  exit 1
fi
exec java -jar "$GRADLE_WRAPPER_JAR" "$@"
